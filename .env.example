[TEMPLATE]
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SSR failures are alerted on the `ssr` channel: storage/logs/ssr.log, plus Slack
# whenever LOG_SLACK_WEBHOOK_URL is set. See the SSR block at the bottom.
# LOG_SSR_LEVEL=warning
# LOG_SSR_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The disk private uploads are written to and read back from: documents, materials,
# submissions, admission attachments, finished recordings. `local` is storage/app/private.
# A deployment whose filesystem does not persist (Laravel Cloud) names a private bucket
# here instead — see docs/DEPLOY.md, "Laravel Cloud".
PRIVATE_DISK=local
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Live lessons (MediaMTX). See docs/live-classroom-plan.md and config/media.php.
# -----------------------------------------------------------------------------
# Where the browser publishes (WHIP) and watches (WHEP). This must be the URL
# the *browser* can reach: the public HTTPS origin in production, or
# http://localhost:8889 with the compose stack. Empty disables the studio with
# an honest "not configured" message instead of a broken button.
MEDIA_WEBRTC_URL=
# The same live server's HLS endpoint, the fallback the student player switches
# to when a network blocks WebRTC's UDP port (port 8888 with the compose stack:
# http://localhost:8888). Empty disables the fallback, so a blocked school
# network has no second path. The CSP follows this value — it is added to
# connect-src and media-src — so it must be the URL the *browser* can reach.
MEDIA_HLS_URL=
# The live server's control API, used to reconcile sessions whose publisher
# went away. With the compose stack: http://127.0.0.1:9997.
MEDIA_API_URL=
# Private control API credentials; matching values are checked by /media/authorize.
# Empty credentials deny control API access.
MEDIA_API_USER=
MEDIA_API_PASSWORD=
# App-reachable HLS origin; the authenticated proxy protects playlists/segments.
MEDIA_HLS_INTERNAL_URL=
# Shared secret for the MediaMTX -> app hook endpoint. An empty secret refuses
# every hook call, which is the safe default.
MEDIA_HOOK_SECRET=
# Binary names, for images that ship them under other paths.
MEDIA_FFMPEG_BINARY=ffmpeg
MEDIA_FFPROBE_BINARY=ffprobe
# Hours a file may sit on the scratch recordings disk before live-sessions:prune deletes
# it (config/media.php).
MEDIA_RECORDINGS_RETENTION_HOURS=24

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Archil - persistent, shared filesystem for agents (mount or serverless exec).
# Create an API key at https://console.archil.com/, then set it here or in the
# deploy's secret store. NEVER commit a real key.
# Serverless exec is AWS-only today: aws-us-east-1, aws-us-west-2, aws-eu-west-1.
# Pick the one closest to where this app's compute runs (defaults match AWS_DEFAULT_REGION).
# -----------------------------------------------------------------------------
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1

VITE_APP_NAME="${APP_NAME}"

# Inertia server-side rendering: pages are pre-rendered by the Node process from
# `php artisan inertia:start-ssr`, reading the bundle `npm run build` compiles into
# bootstrap/ssr/ssr.js. Inertia's own defaults apply when these are unset: SSR is on,
# but it switches itself off, silently, whenever no bundle exists.
INERTIA_SSR_ENABLED=true
# Without a timeout, the render request waits out Laravel's 30s HTTP default when the
# SSR server is unreachable, and every page pays it. See docs/DEPLOY.md.
INERTIA_SSR_TIMEOUT=5
# Losing SSR costs nothing but latency: the page still answers 200 and renders in the
# browser. Every failure is alerted on the `ssr` channel, which is the file
# storage/logs/ssr.log and, when this webhook is set, that Slack channel too.
# LOG_SLACK_WEBHOOK_URL=
