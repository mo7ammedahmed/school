# =============================================================================
# Aether School OS - Production Environment Template
#
# Copy this file to .env.production (or your secret manager) and fill in ALL
# placeholders. NEVER commit real secrets. This file is tracked; .env.production
# is in .gitignore.
#
# UNTESTED: This file has not been validated against a running production deploy.
# =============================================================================

# -----------------------------------------------------------------------------
# Application (config/app.php)
# -----------------------------------------------------------------------------
APP_NAME="Aether School OS"
APP_ENV=production
APP_KEY=           # GENERATE WITH: php artisan key:generate --show  |  NEVER COMMIT THE RESULT
APP_DEBUG=false
APP_URL=https://school.example.com        # CHANGE TO YOUR PRODUCTION URL

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Encryption key rotation (config/app.php:104-108)
# APP_PREVIOUS_KEYS=base64:oldkey1,base64:oldkey2

# -----------------------------------------------------------------------------
# Logging (config/logging.php)
# -----------------------------------------------------------------------------
# JSON logging to stderr is recommended for containerized production.
# The "stderr" channel uses Monolog StreamHandler with php://stderr.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=info
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter   # Uncomment for JSON lines
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# -----------------------------------------------------------------------------
# Database - MySQL 8.4 (config/database.php)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql                     # Or your managed MySQL host (RDS, Cloud SQL, etc.)
DB_PORT=3306
DB_DATABASE=school                # CHANGE
DB_USERNAME=school                # CHANGE
DB_PASSWORD=                      # CHANGE - STRONG PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

# SSL CA for managed MySQL (e.g. AWS RDS, Azure, GCP Cloud SQL)
# MYSQL_ATTR_SSL_CA=/path/to/ca.pem

# -----------------------------------------------------------------------------
# Redis (config/database.php, config/cache.php, config/queue.php)
# Client is predis/predis (pure PHP) - REDIS_CLIENT=predis is REQUIRED
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis                  # Or your managed Redis host (ElastiCache, etc.)
REDIS_PORT=6379
REDIS_PASSWORD=                   # SET IF YOUR REDIS REQUIRES AUTH
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX="aether-school-database-"
# REDIS_CLUSTER=redis
# REDIS_PERSISTENT=false
# REDIS_USERNAME=                 # Redis 6+ ACL username if needed
# REDIS_URL=                      # Alternative: full connection URL
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# Cache & Queue specific Redis connections (optional, defaults shown)
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# -----------------------------------------------------------------------------
# Session (config/session.php) - PRODUCTION DEFAULTS
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # Encrypt session payload
SESSION_SECURE_COOKIE=true        # HTTPS only (requires APP_URL=https://...)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
# SESSION_DOMAIN=.example.com     # Set if using subdomains
# SESSION_CONNECTION=             # Redis connection name (default: default)
# SESSION_STORE=                  # Cache store name (default: redis)
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false

# -----------------------------------------------------------------------------
# Cache (config/cache.php)
# -----------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX="aether-school-cache-"
# CACHE_PREFIX=                   # Override if needed

# Database cache fallback (if not using Redis for cache)
# DB_CACHE_CONNECTION=mysql
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=mysql
# DB_CACHE_LOCK_TABLE=cache_locks

# -----------------------------------------------------------------------------
# Queue (config/queue.php)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
# DB_QUEUE_CONNECTION=mysql       # If using database queue
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# DB_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# -----------------------------------------------------------------------------
# Filesystem (config/filesystems.php)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3

# S3-compatible storage (Decision 5: private/S3-compatible for student documents)
# The config defines disks: local, public, s3. No "private" disk exists yet.
# TODO: Add a "private" disk in config/filesystems.php for student documents
#       (Decision 5 requires private storage; currently only "s3" is configured).
AWS_ACCESS_KEY_ID=                # CHANGE
AWS_SECRET_ACCESS_KEY=            # CHANGE
AWS_DEFAULT_REGION=us-east-1      # CHANGE
AWS_BUCKET=                       # CHANGE - bucket for public + private objects
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=                        # Custom CDN URL (optional)
# AWS_ENDPOINT=                   # For MinIO, DigitalOcean Spaces, etc. (optional)

# -----------------------------------------------------------------------------
# Mail (config/mail.php) - REAL SMTP, NOT MAILPIT
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls                   # or ssl
MAIL_HOST=smtp.example.com        # CHANGE - your SMTP host (SES, Postmark, SendGrid, etc.)
MAIL_PORT=587                     # 587 (tls) or 465 (ssl)
MAIL_USERNAME=                    # CHANGE
MAIL_PASSWORD=                    # CHANGE
MAIL_FROM_ADDRESS="no-reply@school.example.com"   # CHANGE
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_EHLO_DOMAIN=school.example.com   # Optional: defaults to APP_URL host
# MAIL_LOG_CHANNEL=               # Optional: log channel for mail failures

# Alternative mailers (uncomment one and configure if not using SMTP):
# MAIL_MAILER=ses
# MAIL_MAILER=postmark
# MAIL_MAILER=resend
# MAIL_MAILER=sendmail
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# -----------------------------------------------------------------------------
# Broadcast (config/broadcasting.php not present - using defaults)
# -----------------------------------------------------------------------------
# BROADCAST_CONNECTION=log        # Default in .env.example; not used without config/broadcasting.php

# -----------------------------------------------------------------------------
# Hashing (config/hashing.php not present - using defaults)
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Third-Party Services (config/services.php)
# -----------------------------------------------------------------------------
# Payment gateways, translation providers, etc. - configure as needed

# Moyasar (if used)
# MOYASAR_API_KEY=
# MOYASAR_PUBLISHABLE_KEY=

# Translation (config/services.php:56-87)
TRANSLATION_PROVIDER=nvidia       # nvidia | openai | anthropic | gemini
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/riva-translate-4b-instruct-v2
NVIDIA_TIMEOUT=45

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=45

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_TIMEOUT=45

# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=45

# Slack (for notifications/logging)
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# Postmark / Resend / SES (if using those mailers)
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=

# -----------------------------------------------------------------------------
# Bilingual/Translation Tuning (config/bilingual.php)
# -----------------------------------------------------------------------------
# TRANSLATION_BACKFILL_LIMIT=100
# TRANSLATION_RUN_SECONDS=16
# TRANSLATION_REQUEST_SECONDS=10
# TRANSLATION_CACHE_DAYS=30
# TRANSLATION_ON_SAVE_SECONDS=6
# TRANSLATION_AUTOFILL_IN_CONSOLE=false

# -----------------------------------------------------------------------------
# Vite / Frontend
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Security-Relevant Flags (verify each is read by some config/*.php)
# -----------------------------------------------------------------------------
# APP_DEBUG=false                 # Already set above
# SESSION_ENCRYPT=true            # Already set above
# SESSION_SECURE_COOKIE=true      # Already set above
# SESSION_HTTP_ONLY=true          # Already set above
# SESSION_SAME_SITE=lax           # Already set above
# CACHE_STORE=redis               # Already set above
# QUEUE_CONNECTION=redis          # Already set above
# SESSION_DRIVER=redis            # Already set above
# LOG_CHANNEL=stderr              # Already set above
# LOG_LEVEL=info                  # Already set above
# FILESYSTEM_DISK=s3              # Already set above
# REDIS_CLIENT=predis             # Already set above (critical: phpredis ext not installed)
