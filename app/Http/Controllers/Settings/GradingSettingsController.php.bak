<?php

namespace App\Http\Controllers\Settings;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Illuminate\Http\RedirectResponse;

class GradingSettingsController extends Controller
{
    public function edit(): \Inertia\Response
    {
        $settings = config('settings.grading', [
            'system' => 'percentage',
            'scales' => [
                [
                    'name' => 'A+',
                    'min_percentage' => 90,
                    'max_percentage' => 100,
                    'grade_point' => 4.0,
                ],
                [
                    'name' => 'A',
                    'min_percentage' => 80,
                    'max_percentage' => 89,
                    'grade_point' => 3.7,
                ],
                [
                    'name' => 'B+',
                    'min_percentage' => 70,
                    'max_percentage' => 79,
                    'grade_point' => 3.3,
                ],
                [
                    'name' => 'B',
                    'min_percentage' => 60,
                    'max_percentage' => 69,
                    'grade_point' => 3.0,
                ],
                [
                    'name' => 'C',
                    'min_percentage' => 50,
                    'max_percentage' => 59,
                    'grade_point' => 2.0,
                ],
                [
                    'name' => 'F',
                    'min_percentage' => 0,
                    'max_percentage' => 49,
                    'grade_point' => 0.0,
                ],
            ],
            'rounding_method' => 'nearest',
            'include_extracurricular' => true,
        ]);

        return inertia('settings/grading/edit', [
            'settings' => $settings,
        ]);
    }

    public function update(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'system' => 'required|in:percentage,letter,gpa',
            'scales' => 'required|array|min:1',
            'scales.*.name' => 'required|string|max:10',
            'scales.*.min_percentage' => 'required|integer|min:0|max:100',
            'scales.*.max_percentage' => 'required|integer|min:0|max:100',
            'scales.*.grade_point' => 'required|numeric|min:0|max:4.0',
            'rounding_method' => 'required|in:nearest,floor,ceil',
            'include_extracurricular' => 'required|boolean',
        ]);

        $settingsPath = config_path('settings.php');

        if (!file_exists($settingsPath)) {
            file_put_contents($settingsPath, "<?php\n\nreturn [\n    'grading' => [],\n];\n");
        }

        $settings = require $settingsPath;
        $settings['grading'] = $validated;

        $export = var_export($settings, true);
        $content = "<?php\n\nreturn " . $export . ";\n";

        file_put_contents($settingsPath, $content);

        return redirect()->route('settings.grading.edit')->with('success', 'Grading settings updated successfully.');
    }
}
