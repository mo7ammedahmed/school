APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SSR failures are alerted on the `ssr` channel: storage/logs/ssr.log, plus Slack
# whenever LOG_SLACK_WEBHOOK_URL is set. See the SSR block at the bottom.
# LOG_SSR_LEVEL=warning
# LOG_SSR_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia server-side rendering: pages are pre-rendered by the Node process from
# `php artisan inertia:start-ssr`, reading the bundle `npm run build` compiles into
# bootstrap/ssr/ssr.js. Inertia's own defaults apply when these are unset: SSR is on,
# but it switches itself off, silently, whenever no bundle exists.
INERTIA_SSR_ENABLED=true
# Without a timeout, the render request waits out Laravel's 30s HTTP default when the
# SSR server is unreachable, and every page pays it. See docs/DEPLOY.md.
INERTIA_SSR_TIMEOUT=5
# Losing SSR costs nothing but latency: the page still answers 200 and renders in the
# browser. Every failure is alerted on the `ssr` channel, which is the file
# storage/logs/ssr.log and, when this webhook is set, that Slack channel too.
# LOG_SLACK_WEBHOOK_URL=
